# The installer uses this as an internal Compose template, generates the required
# secrets, and writes the operator configuration to /etc/towbar/towbar.yml.
# Do not edit the generated /etc/towbar/towbar.env. For a manual development setup,
# copy it to .env and generate each secret independently:
#   openssl rand -hex 32
# TOWBAR_CREDENTIALS_KEY must be a separate 32-byte Base64 value:
#   openssl rand -base64 32 | tr -d '\n'

# The installer selects local or public. Local publishes only
# http://localhost:4021. Public publishes ports 80 and 443 and enables Caddy's
# automatic Let's Encrypt certificate lifecycle for TOWBAR_GATEWAY_DOMAIN.
COMPOSE_PROFILES=local
TOWBAR_INSTALL_MODE=local
TOWBAR_GATEWAY_DOMAIN=
TOWBAR_BIND_ADDRESS=127.0.0.1
TOWBAR_PORT=4021
# Temporal UI always binds to loopback, independently of TOWBAR_BIND_ADDRESS.
TOWBAR_TEMPORAL_UI_PORT=8233
TOWBAR_NETWORK_NAME=towbar-platform

TOWBAR_POSTGRES_PASSWORD=replace-with-64-random-hex-characters
TOWBAR_DATABASE_RUNTIME_PASSWORD=replace-with-different-64-random-hex-characters
TOWBAR_CREDENTIALS_KEY=replace-with-base64-encoded-32-byte-key
TOWBAR_INTERNAL_HMAC_SECRET=replace-with-at-least-32-random-characters

# Towbar's bundled gateway is one trusted hop in both installation modes.
TOWBAR_TRUSTED_PROXY_HOPS=1
# Shared per-IP rate limit for bearer API and MCP requests.
# TOWBAR_API_RATE_LIMIT_MAX=60
# TOWBAR_API_RATE_LIMIT_WINDOW_SECONDS=60

# Optional: set this to the manifest app ID for this Towbar worker so a
# self-deployment can hand cleanup to the newly healthy worker.
# TOWBAR_APP_ID=towbar-worker

# Global Temporal activity capacity. Per-server buildConcurrency remains the
# deployment limit for each destination host. Increase this only after checking
# worker and destination-host capacity.
# TOWBAR_WORKER_MAX_CONCURRENT_ACTIVITIES=4

# Optional post-deployment image vulnerability scanning capability. Each App
# must also set vulnerabilityScanning: true in its deployment manifest. Results
# are cached by immutable digest and reused until explicitly rescanned. Keep the
# scanner image pinned by tag and multi-architecture digest.
# TOWBAR_VULNERABILITY_SCANNING_ENABLED=false
# TOWBAR_VULNERABILITY_SCAN_MAX_AGE_HOURS=168
# TOWBAR_TRIVY_IMAGE=aquasec/trivy:0.74.0@sha256:62b1e65e8869bc4b4c6aa4fa2b21595256c7c2f6018a9d9ad61caf87187c1969

TOWBAR_APP_BASE_URL=http://localhost:4021

# Integrations are enabled only from the runtime environment. Towbar validates
# every enabled provider at startup and hides disabled providers in the UI.
# Secrets are direct values; multiline PEM/JSON values use Base64.
# TOWBAR_GITHUB_ENABLED=false
# TOWBAR_GITHUB_APP_ID=
# TOWBAR_GITHUB_APP_SLUG=
# TOWBAR_GITHUB_PRIVATE_KEY_BASE64=
# TOWBAR_GITHUB_WEBHOOK_SECRET=
# TOWBAR_GITHUB_API_URL=https://api.github.com

# TOWBAR_GITLAB_ENABLED=false
# TOWBAR_GITLAB_BASE_URL=https://gitlab.com
# TOWBAR_GITLAB_ALLOW_PRIVATE_NETWORK=false
# TOWBAR_GITLAB_OAUTH_CLIENT_ID=
# TOWBAR_GITLAB_OAUTH_CLIENT_SECRET=
# TOWBAR_GITLAB_OAUTH_REDIRECT_URI=http://localhost:4021/v1/core/gitlab/oauth/callback
# TOWBAR_GITLAB_WEBHOOK_SECRET=

# TOWBAR_REGISTRY_ENABLED=false
# TOWBAR_REGISTRY_HOST=
# TOWBAR_REGISTRY_USERNAME=
# TOWBAR_REGISTRY_PASSWORD=
# TOWBAR_REGISTRY_ALLOW_PRIVATE_NETWORK=false

# TOWBAR_AWS_ENABLED=false
# TOWBAR_AWS_REGION=
# TOWBAR_AWS_ACCESS_KEY_ID=
# TOWBAR_AWS_SECRET_ACCESS_KEY=

# S3-compatible storage and Cloudflare R2 use the same field set. Replace S3
# with R2 for the R2 variables.
# TOWBAR_S3_ENABLED=false
# TOWBAR_S3_ENDPOINT=
# TOWBAR_S3_REGION=
# TOWBAR_S3_BUCKET=
# TOWBAR_S3_PREFIX=
# TOWBAR_S3_ADDRESSING_STYLE=auto
# TOWBAR_S3_ALLOW_PRIVATE_NETWORK=false
# TOWBAR_S3_CUSTOM_CA_BASE64=
# TOWBAR_S3_ACCESS_KEY_ID=
# TOWBAR_S3_SECRET_ACCESS_KEY=
# TOWBAR_R2_ENABLED=false
# TOWBAR_R2_ENDPOINT=
# TOWBAR_R2_REGION=
# TOWBAR_R2_BUCKET=
# TOWBAR_R2_PREFIX=
# TOWBAR_R2_ADDRESSING_STYLE=auto
# TOWBAR_R2_ALLOW_PRIVATE_NETWORK=false
# TOWBAR_R2_CUSTOM_CA_BASE64=
# TOWBAR_R2_ACCESS_KEY_ID=
# TOWBAR_R2_SECRET_ACCESS_KEY=

# TOWBAR_GCS_ENABLED=false
# TOWBAR_GCS_PROJECT_ID=
# TOWBAR_GCS_BUCKET=
# TOWBAR_GCS_PREFIX=
# TOWBAR_GCS_SERVICE_ACCOUNT_JSON_BASE64=

# TOWBAR_INFISICAL_ENABLED=false
# TOWBAR_INFISICAL_BASE_URL=https://app.infisical.com
# TOWBAR_INFISICAL_ALLOW_PRIVATE_NETWORK=false
# TOWBAR_INFISICAL_CLIENT_ID=
# TOWBAR_INFISICAL_CLIENT_SECRET=
# TOWBAR_DOPPLER_ENABLED=false
# TOWBAR_DOPPLER_TOKEN=
# TOWBAR_CLOUDFLARE_ENABLED=false
# TOWBAR_CLOUDFLARE_ACCOUNT_ID=
# TOWBAR_CLOUDFLARE_ZONE_ID=
# TOWBAR_CLOUDFLARE_API_TOKEN=
# TOWBAR_CLOUDFLARE_CLOUDFLARED_IMAGE=

# Notification configuration is one JSON document:
# {"providers":{"slack":{"botToken":"xoxb-..."}},"routes":[{"id":"deployments","provider":"slack","enabled":true,"categories":["deployments"],"config":{"channelId":"C123"}}]}
# Discord webhooks use providers.discord: [{"webhookId":"123456789012345678","webhookToken":"..."}].
# Webhook push endpoints use providers.webhook: [{"id":"operations","label":"Operations","url":"https://hooks.example.com/events","headers":{"Authorization":"Bearer ..."},"signingSecret":"at-least-32-characters"}].
# TOWBAR_NOTIFICATIONS_ENABLED=false
# TOWBAR_NOTIFICATION_CONFIG_JSON=


# Account setup/recovery use local CLI commands; see docs/self-hosting/team-access.
# Keep password breach checks enabled unless this is an isolated installation.
# TOWBAR_PASSWORD_BREACH_CHECK=true
# TOWBAR_PASSWORD_VERIFY_CONCURRENCY=2
# TOWBAR_PASSWORD_VERIFY_QUEUE_LIMIT=16

# Optional browser and Next.js observability.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
