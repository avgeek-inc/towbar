# Copy this file to .env. Generate each database/signing secret independently:
#   openssl rand -hex 32
# TOWBAR_CREDENTIALS_KEY must be a separate 32-byte Base64 value:
#   openssl rand -base64 32 | tr -d '\n'

TOWBAR_BIND_ADDRESS=127.0.0.1
TOWBAR_API_PORT=4020
TOWBAR_APP_PORT=4021
TOWBAR_SSO_PORT=4022
TOWBAR_TEMPORAL_UI_PORT=8233
TOWBAR_NETWORK_NAME=towbar-platform

TOWBAR_POSTGRES_PASSWORD=replace-with-64-random-hex-characters
TOWBAR_DATABASE_RUNTIME_PASSWORD=replace-with-different-64-random-hex-characters
TOWBAR_CREDENTIALS_KEY=replace-with-base64-encoded-32-byte-key
TOWBAR_INTERNAL_HMAC_SECRET=replace-with-at-least-32-random-characters

# Keep 0 when the API is reached directly. Set this to the exact number of
# trusted reverse-proxy hops in front of the API before Towbar reads
# X-Forwarded-For (for example, 1 for a single Caddy proxy).
TOWBAR_TRUSTED_PROXY_HOPS=0

# Optional: set this to the manifest app ID for this Towbar worker so a
# self-deployment can hand cleanup to the newly healthy worker.
TOWBAR_APP_ID=towbar-worker

TOWBAR_API_BASE_URL=http://localhost:4020
TOWBAR_APP_BASE_URL=http://localhost:4021
TOWBAR_SSO_BASE_URL=http://localhost:4022
TOWBAR_WEBSITE_BASE_URL=https://towbar.dev

# GitHub App integration is optional at startup, but required to add Sources.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# Optional browser and Next.js observability.
NEXT_PUBLIC_SENTRY_DSN=
