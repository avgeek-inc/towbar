    "./layouts/page": "./src/layouts/page.tsx",
    "./layouts/sidebar-icons": "./src/layouts/sidebar-icons.ts",
    "./layouts/workspace-document": "./src/layouts/workspace-document.tsx",
    "./lib/observability-global-error": "./src/lib/observability-global-error.tsx",
    "./lib/*": "./src/lib/*.ts",
