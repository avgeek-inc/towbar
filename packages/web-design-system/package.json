{
  "name": "@workspace/web-design-system",
  "description": "OSS-safe UI primitives used by Towbar.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@heroui/react": "catalog:",
