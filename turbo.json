{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "SOURCE_COMMIT",
    "DATABASE_TOWBAR_URL",
    "DATABASE_TOWBAR_MIGRATOR_URL",
    "TEMPORAL_ADDRESS",
    "TEMPORAL_NAMESPACE",
    "TEMPORAL_API_KEY",
    "TOWBAR_API_BASE_URL",
    "TOWBAR_APP_ID",
    "TOWBAR_APP_BASE_URL",
    "TOWBAR_SSO_BASE_URL",
    "TOWBAR_WEBSITE_BASE_URL",
    "NEXT_PUBLIC_TOWBAR_API_BASE_URL",
    "NEXT_PUBLIC_TOWBAR_APP_BASE_URL",
    "NEXT_PUBLIC_TOWBAR_SSO_BASE_URL",
    "NEXT_PUBLIC_TOWBAR_WEBSITE_BASE_URL",
    "TOWBAR_CREDENTIALS_KEY",
    "TOWBAR_INTERNAL_HMAC_SECRET",
    "TOWBAR_TRUSTED_PROXY_HOPS",
    "TOWBAR_PASSWORD_VERIFY_CONCURRENCY",
    "TOWBAR_PASSWORD_VERIFY_QUEUE_LIMIT",
    "TOWBAR_RECOVERY_EMAIL",
    "GITHUB_APP_ID",
    "GITHUB_APP_SLUG",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_APP_PRIVATE_KEY_BASE64",
    "GITHUB_WEBHOOK_SECRET",
    "WORKER_HEALTH_PORT",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ALLOW_MISSING",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_RELEASE",
    "NEXT_RUNTIME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"] },
    "dev": { "cache": false, "persistent": true },
    "dev:worker": { "cache": false, "persistent": true }
  }
}
