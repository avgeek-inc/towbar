{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "SOURCE_COMMIT",
    "DATABASE_TOWBAR_URL",
    "TOWBAR_TEST_DATABASE_URL",
    "TOWBAR_TEST_TEMPORAL_ADDRESS",
    "DATABASE_TOWBAR_MIGRATOR_URL",
    "TEMPORAL_ADDRESS",
    "TEMPORAL_NAMESPACE",
    "TEMPORAL_API_KEY",
    "TOWBAR_INTERNAL_API_BASE_URL",
    "TOWBAR_APP_ID",
    "TOWBAR_APP_BASE_URL",
    "NEXT_PUBLIC_TOWBAR_APP_BASE_URL",
    "TOWBAR_CREDENTIALS_KEY",
    "TOWBAR_INTERNAL_HMAC_SECRET",
    "TOWBAR_TRUSTED_PROXY_HOPS",
    "TOWBAR_API_RATE_LIMIT_MAX",
    "TOWBAR_API_RATE_LIMIT_WINDOW_SECONDS",
    "TOWBAR_PASSWORD_VERIFY_CONCURRENCY",
    "TOWBAR_PASSWORD_VERIFY_QUEUE_LIMIT",
    "WORKER_HEALTH_PORT",
    "NEXT_PUBLIC_SENTRY_DSN",
    "SENTRY_ALLOW_MISSING",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_RELEASE",
    "NEXT_RUNTIME",
    "TOWBAR_MONITORING_BINARY_DIR",
    "TOWBAR_PASSWORD_BREACH_CHECK",
    "TOWBAR_TEAM_TEST_DATABASE_URL",
    "TOWBAR_SETTINGS_TEST_DATABASE_URL",
    "TOWBAR_RECOVERY_TEST_DATABASE_URL",
    "TOWBAR_TERMINAL_TEST_DATABASE_URL",
    "TOWBAR_AUTH_PROOF_DATABASE_URL",
    "TOWBAR_FIXTURE_ROLE",
    "TOWBAR_FIXTURE_AUTH_STATE",
    "TOWBAR_FIXTURE_SMTP_UNAVAILABLE",
    "TOWBAR_FIXTURE_SMTP_CONFIGURED",
    "TOWBAR_FIXTURE_SLACK_CONFIGURED",
    "TOWBAR_FIXTURE_DISCORD_CONFIGURED",
    "TOWBAR_FIXTURE_TELEGRAM_CONFIGURED",
    "TOWBAR_FIXTURE_WEBHOOK_CONFIGURED",
    "TOWBAR_FIXTURE_GITHUB_CONNECTED",
    "TOWBAR_FIXTURE_NOTIFICATION_PROVIDERS_CONFIGURED",
    "TOWBAR_HISTORY_TEST_DATABASE_URL",
    "TOWBAR_AWS_ACCESS_KEY_ID",
    "TOWBAR_AWS_ENABLED",
    "TOWBAR_AWS_REGION",
    "TOWBAR_AWS_SECRET_ACCESS_KEY",
    "TOWBAR_CLOUDFLARE_ACCOUNT_ID",
    "TOWBAR_CLOUDFLARE_API_TOKEN",
    "TOWBAR_CLOUDFLARE_CLOUDFLARED_IMAGE",
    "TOWBAR_CLOUDFLARE_ENABLED",
    "TOWBAR_CLOUDFLARE_ZONE_ID",
    "TOWBAR_DATABASE_RUNTIME_PASSWORD",
    "TOWBAR_DOPPLER_ENABLED",
    "TOWBAR_DOPPLER_TOKEN",
    "TOWBAR_GCS_BUCKET",
    "TOWBAR_GCS_ENABLED",
    "TOWBAR_GCS_PREFIX",
    "TOWBAR_GCS_PROJECT_ID",
    "TOWBAR_GCS_SERVICE_ACCOUNT_JSON_BASE64",
    "TOWBAR_GITHUB_API_URL",
    "TOWBAR_GITHUB_APP_ID",
    "TOWBAR_GITHUB_APP_SLUG",
    "TOWBAR_GITHUB_ENABLED",
    "TOWBAR_GITHUB_PRIVATE_KEY_BASE64",
    "TOWBAR_GITHUB_WEBHOOK_SECRET",
    "TOWBAR_GITLAB_ALLOW_PRIVATE_NETWORK",
    "TOWBAR_GITLAB_BASE_URL",
    "TOWBAR_GITLAB_ENABLED",
    "TOWBAR_GITLAB_OAUTH_CLIENT_ID",
    "TOWBAR_GITLAB_OAUTH_CLIENT_SECRET",
    "TOWBAR_GITLAB_OAUTH_REDIRECT_URI",
    "TOWBAR_GITLAB_WEBHOOK_SECRET",
    "TOWBAR_INFISICAL_ALLOW_PRIVATE_NETWORK",
    "TOWBAR_INFISICAL_BASE_URL",
    "TOWBAR_INFISICAL_CLIENT_ID",
    "TOWBAR_INFISICAL_CLIENT_SECRET",
    "TOWBAR_INFISICAL_ENABLED",
    "TOWBAR_NOTIFICATIONS_ENABLED",
    "TOWBAR_NOTIFICATION_CONFIG_JSON",
    "TOWBAR_R2_ACCESS_KEY_ID",
    "TOWBAR_R2_ADDRESSING_STYLE",
    "TOWBAR_R2_ALLOW_PRIVATE_NETWORK",
    "TOWBAR_R2_BUCKET",
    "TOWBAR_R2_CUSTOM_CA_BASE64",
    "TOWBAR_R2_ENABLED",
    "TOWBAR_R2_ENDPOINT",
    "TOWBAR_R2_PREFIX",
    "TOWBAR_R2_REGION",
    "TOWBAR_R2_SECRET_ACCESS_KEY",
    "TOWBAR_REGISTRY_ALLOW_PRIVATE_NETWORK",
    "TOWBAR_REGISTRY_ENABLED",
    "TOWBAR_REGISTRY_HOST",
    "TOWBAR_REGISTRY_PASSWORD",
    "TOWBAR_REGISTRY_USERNAME",
    "TOWBAR_S3_ACCESS_KEY_ID",
    "TOWBAR_S3_ADDRESSING_STYLE",
    "TOWBAR_S3_ALLOW_PRIVATE_NETWORK",
    "TOWBAR_S3_BUCKET",
    "TOWBAR_S3_CUSTOM_CA_BASE64",
    "TOWBAR_S3_ENABLED",
    "TOWBAR_S3_ENDPOINT",
    "TOWBAR_S3_PREFIX",
    "TOWBAR_S3_REGION",
    "TOWBAR_S3_SECRET_ACCESS_KEY",
    "TOWBAR_TRIVY_IMAGE",
    "TOWBAR_VULNERABILITY_SCANNING_ENABLED",
    "TOWBAR_VULNERABILITY_SCAN_MAX_AGE_HOURS",
    "TOWBAR_WORKER_MAX_CONCURRENT_ACTIVITIES",
    "PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TOWBAR_DOCKER_TESTS", "TOWBAR_VERIFICATION_RUN_ID"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:worker": {
      "cache": false,
      "persistent": true
    }
  }
}
