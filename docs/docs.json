{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Towbar",
  "description": "Deploy and operate Dockerfile apps, databases, and previews on Ubuntu servers you control.",
  "logo": {
    "light": "/assets/towbar-logo.png",
    "dark": "/assets/towbar-logo.png",
    "href": "/"
  },
  "favicon": "/assets/towbar-favicon.png",
  "colors": {
    "primary": "#A16207",
    "light": "#B08505",
    "dark": "#A16207"
  },
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["docs/index", "docs/concepts", "docs/getting-started"]
          },
          {
            "group": "Deploy",
            "pages": [
              "docs/sources",
              "docs/servers",
              "docs/apps",
              "docs/resources",
              "docs/deployments",
              "docs/previews",
              "docs/domains-tls",
              "docs/secrets"
            ]
          },
          {
            "group": "Operate",
            "pages": [
              "docs/monitoring",
              "docs/backups",
              "docs/restores",
              "docs/troubleshooting"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "docs/integrations/github",
              "docs/integrations/aws",
              "docs/integrations/notifications"
            ]
          }
        ]
      },
      {
        "tab": "Self-hosting",
        "groups": [
          {
            "group": "Run Towbar",
            "pages": [
              "docs/self-hosting/installation",
              "docs/self-hosting/upgrades",
              "docs/self-hosting/architecture",
              "docs/self-hosting/security"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Configuration",
            "pages": [
              "docs/reference/deployment-manifest",
              "docs/reference/environment-variables"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Docs",
        "href": "/docs"
      },
      {
        "type": "github",
        "href": "https://github.com/avgeek-inc/towbar"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/docs/getting-started"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/avgeek-inc/towbar"
    },
    "links": [
      {
        "header": "Documentation",
        "items": [
          {
            "label": "Your first deployment",
            "href": "/docs/getting-started"
          },
          {
            "label": "Install Towbar",
            "href": "/docs/self-hosting/installation"
          },
          {
            "label": "Manifest reference",
            "href": "/docs/reference/deployment-manifest"
          }
        ]
      },
      {
        "header": "Project",
        "items": [
          {
            "label": "GitHub",
            "href": "https://github.com/avgeek-inc/towbar"
          },
          {
            "label": "Changelog",
            "href": "https://github.com/avgeek-inc/towbar/blob/main/CHANGELOG.md"
          },
          {
            "label": "Security",
            "href": "/docs/self-hosting/security"
          }
        ]
      },
      {
        "header": "Legal",
        "items": [
          {
            "label": "Privacy",
            "href": "/privacy"
          },
          {
            "label": "Terms",
            "href": "/terms"
          },
          {
            "label": "Status",
            "href": "/status"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "seo": {
    "indexing": "all"
  },
  "redirects": [],
  "metadata": {
    "timestamp": true
  }
}
