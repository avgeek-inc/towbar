      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["newrelic", "axiom", "betterstack", "datadog", "otlp", "loki"]
      }
    },
    "externalSecrets": {
      "type": "object",
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 256 },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "integration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
