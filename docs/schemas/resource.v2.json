    "access": {
      "type": "object",
      "properties": {
        "sshTunnel": {
          "type": "object",
          "properties": {
            "hostPort": { "type": "integer", "minimum": 1024, "maximum": 65535 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
