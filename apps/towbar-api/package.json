{
  "name": "towbar-api",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Towbar deployment control-plane API.",
  "homepage": "https://api.towbar.dev",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "pnpm --filter @workspace/towbar-core build && pnpm --filter @workspace/towbar-database build && pnpm --filter @workspace/observability-node build",
    "build": "tsc --project tsconfig.build.json",
    "database:migrate:production": "node dist/cli/migrate.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sts": "catalog:",
    "@hono/node-server": "^2.0.11",
    "@temporalio/client": "catalog:",
    "@workspace/observability-node": "workspace:*",
    "@workspace/towbar-core": "workspace:*",
    "@workspace/towbar-database": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "nodemailer": "^9.1.1",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  }
}
