{
  "name": "towbar-api",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Towbar deployment control-plane API.",
  "homepage": "https://api.towbar.dev",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "pnpm --filter @workspace/towbar-access build && pnpm --filter @workspace/towbar-email build && pnpm --filter @workspace/towbar-core build && pnpm --filter @workspace/towbar-database build && pnpm --filter @workspace/observability-node build",
    "build": "tsc --project tsconfig.build.json",
    "database:migrate:production": "node dist/cli/migrate.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\"",
    "auth:setup-code": "tsx src/cli/setup-code.ts",
    "auth:recover-admin": "tsx src/cli/recover-admin.ts",
    "auth:reset-mfa": "tsx src/cli/reset-user-mfa.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sts": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@azure/identity": "4.13.3",
    "@azure/storage-blob": "12.33.0",
    "@better-auth/api-key": "1.7.5",
    "@better-auth/drizzle-adapter": "1.7.5",
    "@better-auth/passkey": "1.7.5",
    "@better-auth/utils": "0.4.2",
    "@google-cloud/storage": "8.2.0",
    "@hono/node-server": "^2.0.11",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/hashes": "2.4.0",
    "@smithy/node-http-handler": "4.12.1",
    "@temporalio/client": "catalog:",
    "@workspace/observability-node": "workspace:*",
    "@workspace/towbar-access": "workspace:*",
    "@workspace/towbar-core": "workspace:*",
    "@workspace/towbar-database": "workspace:*",
    "@workspace/towbar-email": "workspace:*",
    "better-auth": "1.7.5",
    "croner": "10.0.1",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "nodemailer": "^9.1.1",
    "postgres": "catalog:",
    "ssh2": "1.17.0",
    "undici": "7.29.0",
    "ws": "8.21.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@simplewebauthn/server": "13.3.2",
    "@temporalio/proto": "1.23.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.1",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:"
  }
}
