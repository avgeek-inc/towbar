{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/web-design-system/*": [
        "../../packages/web-design-system/src/*"
      ]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/web-design-system/src/**/*.tsx",
    "../../packages/web-design-system/src/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
