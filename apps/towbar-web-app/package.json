{
  "name": "towbar-web-app",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Towbar self-hosted deployment dashboard.",
  "homepage": "https://www.towbar.dev",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 4021 --turbopack",
    "dev:fixture-api": "node ./scripts/fixture-api.ts",
    "start": "next start --port 4021",
    "build": "pnpm next build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint --fix . --max-warnings 0",
    "test": "tsx --test \"src/**/*.test.ts\" && pnpm test:fixture-api",
    "test:fixture-api": "pnpm build:demo && node --test ./scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:demo": "node ./scripts/public-demo/build.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "catalog:",
    "@lezer/highlight": "1.2.4",
    "@simplewebauthn/browser": "13.3.0",
    "@workspace/identity-web-ui": "workspace:*",
    "@workspace/towbar-access": "workspace:*",
    "@workspace/towbar-web-client": "workspace:*",
    "@workspace/towbar-web-ui": "workspace:*",
    "@workspace/web-design-system": "workspace:*",
    "@workspace/web-page-sections": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "date-fns": "^4.4.0",
    "next": "catalog:",
    "qrcode": "1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@simplewebauthn/server": "14.0.3",
    "@types/node": "catalog:",
    "@types/qrcode": "1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "8.18.1",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/towbar-core": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "esbuild": "0.25.12",
    "eslint": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "ws": "8.21.3"
  }
}
