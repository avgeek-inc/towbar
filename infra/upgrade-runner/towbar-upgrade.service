[Unit]
Description=Towbar host upgrade runner
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/towbar-upgrade/runner.py
Restart=on-failure
RestartSec=5
UMask=0077
RuntimeDirectory=towbar-upgrade
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=towbar-upgrade
StateDirectoryMode=0700
# Never leave an upgrade child running after the runner is stopped.
KillMode=control-group
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
